{
  "name": "oracle-instrumentation-console",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ogobrecht/console.git"
  },
  "scripts": {
    "watch": "chokidar sources/* --initial --command \"npm run build\"",
    "build": "npx eslint sources/*.js && npm run docs && node sources/build.mjs && npm run install_create_console_objects && npm run install_apex_plugin",
    "docs": "npx ploc --in sources/CONSOLE.pks --out docs/package-console.md && node docs/build.mjs",
    "install_all": "npm-run-all -s install_create_console_objects install_grant_rights install_apex_plugin",
    "install_create_console_objects": "sqlplus -S /nolog @tests/run install/create_console_objects",
    "install_apex_plugin": "sqlplus -S /nolog @tests/run sources/apex_plugin_dev_install",
    "install_grant_rights": "sqlplus -S /nolog @tests/run_args install/grant_rights PUBLIC",
    "uninstall": "sqlplus -S /nolog @tests/run uninstall/drop_console_objects",
    "test_all": "npm-run-all -s test_ccflags test_performance test_console test_trace test_save_stack",
    "test_ccflags": "sqlplus -S /nolog @tests/run tests/ccflags",
    "test_console": "sqlplus -S /nolog @tests/run tests/console",
    "test_trace": "sqlplus -S /nolog @tests/run tests/trace",
    "test_save_stack": "sqlplus -S /nolog @tests/run tests/save_stack",
    "test_performance": "sqlplus -S /nolog @tests/run tests/performance",
    "install_logger": "sqlplus -S /nolog @tests/run ../logger/logger_install",
    "unit_tests": "sqlplus -S /nolog @tests/run tests/compile_and_run_unit_tests.sql"
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.24.0",
    "glob": "^11.0.1",
    "markdown-toc": "^1.2.0",
    "npm-check-updates": "^17.1.18",
    "npm-run-all": "^4.1.5",
    "ploc": "^0.9.1",
    "uglify-js": "^3.19.3"
  },
  "dependencies": {}
}